  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueBox
  iniciarAoAtivar: 1
  iniciarComClique: 1
  caixaDeTexto: {fileID: 422352686}
  textoExibido: {fileID: 945383841}
  linhas:
  - 'Jerry: Tem doze arquivos de texto aqui. Mas repare nos nomes.'
  - 'Jerry: Alguns estao cheios de simbolos estranhos. Foi o CODEMIND.'
  - 'Jerry: Ele so estragou os nomes dos backups. Os outros estao normais.'
  - 'Jerry: Isso ja serve de pista. Guarde essa ideia.'
  - 'Jerry: Para abrir um arquivo, use o comando "Hack Document".'
  - 'Jerry: Escreva assim: "Hack Document:" e depois o nome do arquivo.'
  - 'Jerry: Escreva o nome igual ao que aparece, ate os simbolos.'
  - 'Jerry: Se esquecer, o botao do caderno guarda os comandos que voce ja usou.'
  atrasoPorCaractere: 0.03
  atrasoParaSumir: 3
  sumirSozinhoNaUltimaLinha: 1
  tempoParaSumirSozinho: 3
  avancarComClique: 1
  avancarSomenteClicandoNoRadio: 1
  depurarClique: 1
  teclaAvancar: 32
  Radio: {fileID: 1783240289}
  exigirRadioLigadoParaClicar: 1
