  m_Script: {fileID: 11500000, guid: 3764d475bdd223146949d067ac8edf27, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueBox
  iniciarAoAtivar: 0
  iniciarComClique: 1
  caixaDeTexto: {fileID: 422352686}
  textoExibido: {fileID: 945383841}
  linhas:
  - 'Jerry: O programa de restauracao rodou e seu PC voltou ao ultimo estado salvo.'
  - 'Jerry: Os nomes dos backups voltaram ao normal. Mas o CODEMIND nao sumiu. Ele
    e uma IA forte.'
  - 'Jerry: Ele deixou copias de si nos backups.'
  - 'Jerry: E eu vi no registro que voce gastou muito tempo abrindo as pastas uma
    por uma.'
  - 'Jerry: Agora eu vou te ajudar a relembrar como escrever varios comandos juntos,
    em uma unica vez. Isso e um programa.'
  - 'Jerry: Use ";" para separar os comando e "Enter" para executar tudo de uma vez.'
  - 'Jerry: Ele roda do primeiro para o ultimo, na ordem em que voce escreveu. A
    ordem importa!'
  - 'Jerry: Comece com estes tres comandos: "Documentos:1", "Hack Folder:1" e "Hack
    Document: backup_v3".'
  atrasoPorCaractere: 0.03
  atrasoParaSumir: 3
  sumirSozinhoNaUltimaLinha: 0
  tempoParaSumirSozinho: 3
  avancarComClique: 1
  avancarSomenteClicandoNoRadio: 1
  depurarClique: 0
  teclaAvancar: 32
  Radio: {fileID: 1783240289}
  exigirRadioLigadoParaClicar: 1
  radioAoComecarDialogo: 2
  radioAoTerminarDialogo: 2
  animacaoParaEsperar: {fileID: 0}
  tempoMaxEsperaAnimacao: 10
  objetoAtivarAoTerminar: {fileID: 0}
