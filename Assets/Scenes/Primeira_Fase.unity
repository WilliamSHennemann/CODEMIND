  textoExibido: {fileID: 945383841}
  linhas:
  - 'Jerry: Vixi, oque aconteceu aqui, esta tudo trancado.'
  - 'Jerry: Voce esta vendo aquela pasta com o cadeado corrompido?'
  - 'Jerry: Tenta hackear ela, ela tinha umas senhas uteis nao?'
  - 'Jerry: Talvez elas ajudem a abrir o seu cofre, ele tem todo o backup do PC.'
  - 'Jerry: Pelo que eu me lembre.'
  atrasoInicial: 2
