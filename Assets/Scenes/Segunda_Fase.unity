  iniciarAoAtivar: 0
  iniciarComClique: 1
  caixaDeTexto: {fileID: 422352686}
  textoExibido: {fileID: 945383841}
  linhas:
  - 'Jerry: Ok, temos que entrar no Nucleo agora.'
  - 'Jerry: Voce tinha criado um script para fazer seu pc voltar para uma versao
    antiga, lembra?'
  - 'Jerry: Mas voce colocou uma seguranca pesada nela.'
  - 'Jerry: Voce vai ter que entrar em Projetos e pegar a senha.'
  - 'Jerry: Ir para Fotos, pegar a senha, ir para o Diario e pegar a senha do Nucleo.'
  - 'Jerry: Bom, boa sorte. Fazendo isso tantas vezes, voce com certeza vai lembrar
    dos comandos.'
  - 'Jerry: Se esquecer, so clicar no botao a esquerda da barra.'
  atrasoPorCaractere: 0.03
  atrasoParaSumir: 3
  sumirSozinhoNaUltimaLinha: 1
  tempoParaSumirSozinho: 3
  avancarComClique: 1
  avancarSomenteClicandoNoRadio: 1
  depurarClique: 0
  teclaAvancar: 32
